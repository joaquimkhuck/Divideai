# Divide Aí — nomes das variáveis de ambiente. NENHUM valor aqui.
# Copie para .env (que é ignorado pelo git) e preencha localmente.
# No Replit, os valores vivem no painel Secrets.

# Obrigatórias: a aplicação não sobe sem elas.
DATABASE_URL=
ANTHROPIC_API_KEY=

# Login opcional com Google via Clerk.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Pagamentos de teste via Stripe Checkout.
STRIPE_SECRET_KEY=
PUBLIC_APP_URL=

# Opcionais.
PORT=
NODE_ENV=
LOG_LEVEL=
BASE_PATH=
