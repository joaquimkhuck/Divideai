# Divide Aí — nomes das variáveis de ambiente. NENHUM valor aqui.
# Copie para .env (que é ignorado pelo git) e preencha localmente.
# No Replit, os valores vivem no painel Secrets.

# Obrigatórias: a aplicação não sobe sem elas.
DATABASE_URL=
ANTHROPIC_API_KEY_2=

# Login opcional via Clerk.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
SESSION_SECRET=

# Pagamento da parte via Stripe Checkout (modo teste). Sem a chave, o botão
# some e os endpoints de pagamento respondem 503.
STRIPE_SECRET_KEY=
PUBLIC_APP_URL=

# Opcionais.
PORT=
NODE_ENV=
LOG_LEVEL=
BASE_PATH=
