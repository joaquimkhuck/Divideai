# Divide Aí — nomes das variáveis de ambiente. NENHUM valor aqui.
# Copie para .env (que é ignorado pelo git) e preencha localmente.
# No Replit, os valores vivem no painel Secrets.

# Obrigatórias: a aplicação não sobe sem elas.
DATABASE_URL=
ANTHROPIC_API_KEY_2=

# Login opcional via Clerk.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
SESSION_SECRET=

# Pagamento da parte via Stripe Checkout (modo teste). Sem a chave, o botão
# some e os endpoints de pagamento respondem 503.
STRIPE_SECRET_KEY=
PUBLIC_APP_URL=

# Opcionais.
PORT=
NODE_ENV=
LOG_LEVEL=
BASE_PATH=

# Build do app iOS (Capacitor). Origem da API remota — capacitor://localhost
# não tem acesso ao proxy /api do web, então o app nativo chama esta URL
# direto. Aceita com ou sem /api no final. Ex.: https://divideai.pangeia.cloud
VITE_API_BASE_URL=
